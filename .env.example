# Copy to .env and fill in. .env is gitignored – never commit the key.

# Used only by the server route app/api/scan+api.ts, never shipped in the app.
OPENAI_API_KEY=sk-...
# Optional: another vision-capable model.
# OPENAI_MODEL=gpt-4.1-mini

# Where installed builds find the scan API (EAS Hosting URL). Not needed during development.
# EXPO_PUBLIC_API_URL=https://babyklar.expo.app
